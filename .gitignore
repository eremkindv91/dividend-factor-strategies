# Dividend site: генерируемые/локальные артефакты
# data.json собирается инференсом и деплоится в Pages — в репо не нужен
site/data.json
# returns.json копирует build_data из model_output/returns.json (источник коммитим)
site/returns.json
# кэш цен MOEX персистится через actions/cache
model_output/prices_cache.json
# marketsaw.json генерит CI (production/build_marketsaw.py) и деплоит update.yml — в репо не нужен
site/marketsaw.json
# marlamov.json генерит CI (scripts/build_forward_yield.py) и деплоит update.yml
site/marlamov.json
# RU Quality cross-section генерит CI; last-good source хранится в model_output/quality_rf.json
site/quality.json
# Пила рынка: промежуточные parquet регенерятся research-пайплайном (коммитим winner_model.json + отчёт)
market_saw/data/*.parquet

